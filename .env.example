# API Configuration
EXPO_PUBLIC_API_BASE_URL=https://api.tapswap.com
EXPO_PUBLIC_API_VERSION=v1

# WebSocket Configuration
EXPO_PUBLIC_SOCKET_URL=wss://socket.tapswap.com
EXPO_PUBLIC_SOCKET_PATH=/socket.io

# Authentication
EXPO_PUBLIC_AUTH_TIMEOUT=30000

# NFC Configuration
EXPO_PUBLIC_NFC_READ_TIMEOUT=15000
EXPO_PUBLIC_NFC_WRITE_TIMEOUT=10000

# Feature Flags
EXPO_PUBLIC_ENABLE_DEBUG=false
EXPO_PUBLIC_ENABLE_MOCK_NFC=false

# Firebase (if using push notifications)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=

# TapSwap API — Swagger UI: https://nfcsender.up.railway.app/api-docs#/
EXPO_PUBLIC_API_BASE_URL=https://nfcsender.up.railway.app
# All REST routes are under `/api` (see Swagger `paths`)
EXPO_PUBLIC_API_PREFIX=/api

# WebSocket Configuration
EXPO_PUBLIC_SOCKET_URL=wss://socket.tapswap.com
EXPO_PUBLIC_SOCKET_PATH=/socket.io

# Authentication
EXPO_PUBLIC_AUTH_TIMEOUT=30000

# NFC Configuration
EXPO_PUBLIC_NFC_READ_TIMEOUT=15000
EXPO_PUBLIC_NFC_WRITE_TIMEOUT=10000

# Feature Flags
EXPO_PUBLIC_ENABLE_DEBUG=false
EXPO_PUBLIC_ENABLE_MOCK_NFC=false
# AI REST routes are not on the current Swagger spec — keep false to avoid /api/ai/* 404s
EXPO_PUBLIC_ENABLE_AI_API=false

# Firebase (if using push notifications)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
